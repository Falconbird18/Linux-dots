# Surface-specific overrides; the base remains the running kernel configuration.
# The builder expands @CUSTOM_SUFFIX@ from version.env.
CONFIG_STAGING=y
CONFIG_VIDEO_INTEL_IPU7=y
CONFIG_VIDEO_IMX681=m
CONFIG_VIDEO_OV13858=m
CONFIG_INTEL_SKL_INT3472=m
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_BNEP=m
CONFIG_BT_INTEL_PCIE=m
CONFIG_LOCALVERSION_AUTO=n
CONFIG_RUST=n
CONFIG_LOCALVERSION="@CUSTOM_SUFFIX@"
CONFIG_SOUNDWIRE=y
CONFIG_SOUNDWIRE_INTEL=y
CONFIG_SND_SOC_SOF_INTEL_LNL=y
CONFIG_SND_SOC_RT1320_SDW=m
