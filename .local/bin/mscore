#!/usr/bin/env sh
# Native Linux VST editors embed X11 windows. Use XWayland for the official
# VST-enabled build; honour an explicit MU_QT_QPA_PLATFORM override.
# Use the package-managed official binary (musescore-bin), with VST3 hosting.
# Never prefer an old private AppImage over the installed package.
if [ "${XDG_SESSION_TYPE:-}" = wayland ] || [ -n "${WAYLAND_DISPLAY:-}" ]; then
    export MU_QT_QPA_PLATFORM="${MU_QT_QPA_PLATFORM:-xcb}"
    export QT_QPA_PLATFORM="$MU_QT_QPA_PLATFORM"
    if [ "$MU_QT_QPA_PLATFORM" = xcb ]; then
        # Paired with Hyprland force_zero_scaling: render at the focused
        # monitor's scale. Query at launch so display changes are picked up.
        if [ -z "${QT_SCALE_FACTOR:-}" ]; then
            monitor_scale=
            if command -v hyprctl >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
                monitor_scale=$(python3 - <<'PY_SCALE'
import json
import math
import subprocess

try:
    result = subprocess.run(
        ["hyprctl", "-j", "monitors"], capture_output=True, text=True,
        check=True, timeout=2,
    )
    monitors = json.loads(result.stdout)
    monitor = next((m for m in monitors if m.get("focused")), monitors[0])
    scale = monitor["scale"]
    if isinstance(scale, (int, float)) and not isinstance(scale, bool) and math.isfinite(scale) and 0 < scale <= 10:
        print(scale)
except (OSError, subprocess.SubprocessError, ValueError, KeyError, IndexError, TypeError, AttributeError):
    pass
PY_SCALE
                )
            fi
            export QT_SCALE_FACTOR="${monitor_scale:-1}"
        fi
        export QT_FONT_DPI="${QT_FONT_DPI:-96}"
    fi
fi
# Use an absolute path to avoid invoking this wrapper recursively.
exec /usr/bin/mscore "$@"
